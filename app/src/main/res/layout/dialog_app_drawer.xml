<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#16161E"
    android:fitsSystemWindows="true"
    android:paddingTop="12dp"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingBottom="0dp">

    <!-- Search container -->
    <LinearLayout
        android:id="@+id/drawerSearchBarContainer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_bar"
        android:paddingLeft="14dp"
        android:paddingRight="10dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/drawerSearchIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_search"
            android:tint="#9E9EA8"
            android:contentDescription="@null"
            android:layout_marginEnd="10dp" />

        <EditText
            android:id="@+id/drawerSearchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search apps..."
            android:textColorHint="#757582"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <ImageButton
            android:id="@+id/drawerSearchClear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#9E9EA8"
            android:contentDescription="Clear search"
            android:visibility="gone" />

    </LinearLayout>

    <GridView
        android:id="@+id/drawerGridView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="4"
        android:verticalSpacing="12dp"
        android:horizontalSpacing="8dp"
        android:stretchMode="columnWidth"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:paddingBottom="56dp"
        android:listSelector="@android:color/transparent" />

</LinearLayout>
